{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dcramere-voeding",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dcramere-voeding",
      "database_id": "9defbbed-3c03-46fd-b3fd-b5a51bed981a",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "BACKUPS", "id": "ce3ea2e2d0a64a7382210a86e3bb1138" }
  ],
  // progress photos: private bucket, only served through the Worker after auth
  "r2_buckets": [
    { "binding": "FOTOS", "bucket_name": "dcramere-voeding-fotos" }
  ],
  // Workers AI: reads nutrition labels from photos (free daily allowance)
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
