// Test copy of wrangler.jsonc without the AI binding (npm test / CI). Keep in sync.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dcramere-voeding",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/c/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dcramere-voeding",
      "database_id": "9defbbed-3c03-46fd-b3fd-b5a51bed981a",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "BACKUPS", "id": "ce3ea2e2d0a64a7382210a86e3bb1138" }
  ],
  // progress photos: private bucket, only served through the Worker after auth
  "r2_buckets": [
    { "binding": "FOTOS", "bucket_name": "dcramere-voeding-fotos" }
  ],
  // prices shown on the landing page until Stripe is connected (then the Stripe prices are used)
  "vars": { "PRIJS_CLIENT": "99", "PRIJS_COACH": "149", "VALUTA": "USD", "CONNECT_FEE_PERCENT": "0", "CONNECT_PLATFORM_COUNTRY": "US", "VAPID_PUBLIC": "BAczSVYlFxVgpyhiUl4kLJsno3hxEH9kg-8KkSCNJAwMTs_HzEt1b_1LSGKCdLtOXSUxDSeM25_DqyBxoWdMz3A" },
  // hourly reminders + backup check without a cron slot
  "durable_objects": { "bindings": [{ "name": "SCHEDULER", "class_name": "Scheduler" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Scheduler"] }],
  "observability": { "enabled": true }
}
