{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dcramere-voeding",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dcramere-voeding",
      "database_id": "9defbbed-3c03-46fd-b3fd-b5a51bed981a",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
